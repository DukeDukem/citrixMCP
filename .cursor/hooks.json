{
  "version": 1,
  "hooks": {
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/re_complete_sound_hook.cmd",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/extract_auto_continue_hook.cmd",
        "timeout": 30,
        "loop_limit": null
      },
      {
        "command": ".cursor/hooks/re_complete_sound_hook.cmd",
        "timeout": 30
      }
    ]
  }
}
